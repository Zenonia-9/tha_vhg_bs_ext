<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_vhg_balance_sheet_notes" model="account.report">
        <field name="name">Management Balance Sheet Notes</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_period_comparison" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">today</field>
        <field name="custom_handler_model_id" ref="model_tha_vhg_balance_sheet_notes_report_handler"/>
        <field name="column_ids">
            <record id="report_vhg_balance_sheet_notes_balance" model="account.report.column">
                <field name="name">Amount</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
    </record>

    <record id="report_vhg_balance_sheet_summary" model="account.report">
        <field name="name">Management Balance Sheet Summary</field>
        <field name="filter_unfold_all" eval="False"/>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_period_comparison" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">today</field>
        <field name="custom_handler_model_id" ref="model_tha_vhg_balance_sheet_summary_report_handler"/>
        <field name="column_ids">
            <record id="report_vhg_balance_sheet_summary_balance" model="account.report.column">
                <field name="name">Amount</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
    </record>

    <record id="action_report_vhg_balance_sheet_notes" model="ir.actions.client">
        <field name="name">Management Balance Sheet Notes</field>
        <field name="tag">account_report</field>
        <field name="path">vhg-balance-sheet-notes</field>
        <field name="context" eval="{'report_id': ref('tha_vhg_bs_ext.report_vhg_balance_sheet_notes')}"/>
    </record>
    <record id="action_report_vhg_balance_sheet_summary" model="ir.actions.client">
        <field name="name">Management Balance Sheet Summary</field>
        <field name="tag">account_report</field>
        <field name="path">vhg-balance-sheet-summary</field>
        <field name="context" eval="{'report_id': ref('tha_vhg_bs_ext.report_vhg_balance_sheet_summary')}"/>
    </record>

    <menuitem id="menu_vhg_management_reports" name="Management Reports"
              parent="account.menu_finance_configuration"
              groups="account.group_account_readonly" sequence="5"/>

    <menuitem id="menu_action_report_vhg_balance_sheet_notes" name="Management Balance Sheet Notes"
              action="action_report_vhg_balance_sheet_notes" parent="menu_vhg_management_reports"
              groups="account.group_account_readonly" sequence="60"/>
    <menuitem id="menu_action_report_vhg_balance_sheet_summary" name="Management Balance Sheet Summary"
              action="action_report_vhg_balance_sheet_summary" parent="menu_vhg_management_reports"
              groups="account.group_account_readonly" sequence="70"/>
</odoo>
